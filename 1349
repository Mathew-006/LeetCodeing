import java.util.Arrays;

class Solution {
    public int maxStudents(char[][] seats) {
        int m = seats.length;
        int n = seats[0].length;
        
        int[] broken = new int[m];
        for (int i = 0; i < m; i++) {
            int mask = 0;
            for (int j = 0; j < n; j++) {
                if (seats[i][j] == '#') {
                    mask |= (1 << j);
                }
            }
            broken[i] = mask;
        }
        
        int maxMasks = 1 << n;
        int[][] dp = new int[m][maxMasks];
        for (int[] row : dp) {
            Arrays.fill(row, -1);
        }
        
        int maxStudents = 0;
        
        for (int mask = 0; mask < maxMasks; mask++) {
            if ((mask & (mask >> 1)) == 0 && (mask & broken[0]) == 0) {
                dp[0][mask] = Integer.bitCount(mask);
                maxStudents = Math.max(maxStudents, dp[0][mask]);
            }
        }
        
        for (int i = 1; i < m; i++) {
            for (int currMask = 0; currMask < maxMasks; currMask++) {
                if ((currMask & (currMask >> 1)) != 0 || (currMask & broken[i]) != 0) {
                    continue;
                }
                
                for (int prevMask = 0; prevMask < maxMasks; prevMask++) {
                    if (dp[i - 1][prevMask] == -1) {
                        continue;
                    }
                    
                    if ((currMask & (prevMask >> 1)) == 0 && (currMask & (prevMask << 1)) == 0) {
                        dp[i][currMask] = Math.max(dp[i][currMask], dp[i - 1][prevMask] + Integer.bitCount(currMask));
                    }
                }
                maxStudents = Math.max(maxStudents, dp[i][currMask]);
            }
        }
        
        return maxStudents;
    }
}
