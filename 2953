class Solution {
    public int countCompleteSubstrings(String word, int k) {
        int n = word.length(), ans = 0, start = 0;
        for (int i = 1; i <= n; i++) {
            if (i == n || Math.abs(word.charAt(i) - word.charAt(i - 1)) > 2) {
                ans += countSegment(word.substring(start, i), k);
                start = i;
            }
        }
        return ans;
    }

    private int countSegment(String s, int k) {
        int len = s.length(), count = 0;
        for (int u = 1; u <= 26 && u * k <= len; u++) {
            int win = u * k, valid = 0;
            int[] freq = new int[26];
            for (int i = 0; i < len; i++) {
                if (++freq[s.charAt(i) - 'a'] == k) valid++;
                if (i >= win) {
                    int prev = s.charAt(i - win) - 'a';
                    if (freq[prev]-- == k) valid--;
                }
                if (valid == u) {
                    boolean ok = true;
                    for (int f : freq) if (f > 0 && f < k) { ok = false; break; }
                    if (ok) count++;
                }
            }
        }
        return count;
    }
}
